@poukai-inc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
# Force auth on tarball downloads, not just registry metadata. GitHub Packages
# requires a token on the npm.pkg.github.com/download/... tarball too; with the
# default always-auth=false, pnpm resolves metadata authed but fetches that
# tarball UNauthed → 401 (the real cause of the @poukai-inc/ui install 401,
# masked for ages by the pnpm-store cache). pnpm 10 ignores the host-scoped
# form, so this is set globally. The token is a GitHub read:packages PAT —
# harmless if sent to other registries (they reject/ignore it).
always-auth=true

# pnpm 10 default flipped link-workspace-packages to false. We rely on
# the dual-consumption model: locally a parent pnpm-workspace.yaml lists
# both repos, pnpm should prefer the workspace @poukai-inc/ui. In CI
# there's no workspace, so this setting has no effect and pnpm fetches
# from the registry above.
link-workspace-packages=true
