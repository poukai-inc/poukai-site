@poukai-inc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
# The @poukai-inc/ui tarball is served at the non-standard path
# npm.pkg.github.com/download/... With --frozen-lockfile (resolution skipped)
# pnpm fetches that pinned URL but does not attach auth → 401 (known pnpm +
# GitHub Packages issue; masked for ages by the pnpm-store cache, surfaced by
# the astro 6 lockfile change). Add an auth entry whose nerf-dart matches the
# /download/ path so the token is sent on the tarball fetch too.
//npm.pkg.github.com/download/:_authToken=${NPM_TOKEN}
always-auth=true

# pnpm 10 default flipped link-workspace-packages to false. We rely on
# the dual-consumption model: locally a parent pnpm-workspace.yaml lists
# both repos, pnpm should prefer the workspace @poukai-inc/ui. In CI
# there's no workspace, so this setting has no effect and pnpm fetches
# from the registry above.
link-workspace-packages=true
