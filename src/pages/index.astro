---
/**
 * / — Homepage. All copy sourced from src/content/home.json (R-076 HARD) and
 * validated at build time via src/content/_schemas/home.ts (R-074 HARD).
 *
 * Page structure (6-beat IA — A3 artifact-anchor revision):
 *   Beat 1 — Hero (display — size="display" entrance="stagger", glyph leaned in)
 *   Beat 2 — Statement (conviction beat — on --bg, no band)
 *   Beat 3 — Artifact exhibit (HomeArtifact — inset OBJECT on --surface, NO <h2>)
 *   Beat 4 — What we do / HomeDisciplines (first <h2>, asymmetric lead+two, --bg)
 *   Beat 5 — Why us / HomeComparison (second <h2>, number-led exhibit, recessed band #1)
 *   Beat 6 — Closing CTASection (third <h2>, designed serif close, recessed band #2)
 *
 * Heading hierarchy (R-026, no skipped levels):
 *   <h1>  Hero title (one only)
 *   Statement emits NO heading element (DS rule)
 *   Artifact emits NO heading element (it is an exhibit — spec §4.1)
 *   <h2>  "What we do" (HomeDisciplines via Section)        — <h2> #1
 *   <h3>s  within HomeDisciplines cards (under What-we-do <h2>)
 *   <h2>  "Why pouk.ai" (HomeComparison via Section)        — <h2> #2
 *   <h2>  closing heading (HomeClosingCta via CTASection)   — <h2> #3
 *   Exactly 1 <h1> + 3 <h2>s. No skipped levels.
 *
 * Surface rhythm (exactly TWO --surface-section bands — A2 §16, unchanged):
 *   Band #1 — Why us: site-side .home-whyus-band wrapper
 *   Band #2 — Convert: CTASection surface="recessed" (via .home-convert-close-wrap)
 *   Hero, Statement, Artifact, and What we do all sit on --bg.
 *   Artifact is on --surface (recessed inline, NOT a band — different DS tier).
 *   Merge-guard: --space-16 air between bands (.home-convert-gap div).
 *
 * Scroll-reveal (composition §A3-4):
 *   Five below-hero beats carry data-reveal on their wrapper div:
 *     #1 Statement (.home-statement-gap), #2 Artifact (.home-artifact-gap),
 *     #3 What-we-do (anon div), #4 Why-us (.home-whyus-band), #5 Closing CTA (anon div).
 *   Hero (stagger entrance) is NOT wrapped — DS entrance="stagger" is the entrance.
 *   Reveal driven by site.css (.reveal-on [data-reveal]) + src/scripts/reveal.ts (IO observer).
 *   No React hydration — vanilla TS, once-only, re-inits on astro:page-load.
 *
 * Contact-flow wiring (FS-CF-1):
 *   Hero: mailto: primary Button + booking secondary Button.
 *   Close: mailto: primary Button + booking secondary Button.
 *   Both: mailto: stays primary; booking is the subordinate secondary.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { HomeHero } from "../components/HomeHero";
import { HomeStatement } from "../components/HomeStatement";
import { HomeArtifact } from "../components/HomeArtifact";
import { HomeDisciplines } from "../components/HomeDisciplines";
import { HomeComparison } from "../components/HomeComparison";
import { HomeClosingCta } from "../components/HomeClosingCta";
import homeRaw from "../content/home.json";
import { homeSchema } from "../content/_schemas/home";

const home = homeSchema.parse(homeRaw);
const { meta, hero, statement, artifact, disciplines, comparison, closingCta, jsonLd } = home;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={jsonLd}
  currentRoute="/"
>
  <div class="site-page">
    {/* Beat 1 — Hero (display doorway, glyph leaned in A3 §4.3).
        NOT scroll-revealed — the stagger IS the entrance.
        Content byte-identical; lean-in is CSS column sizing only (site.css). */}
    <HomeHero
      status={hero.status}
      titleBefore={hero.title.before}
      titleEm={hero.title.em}
      titleAfter={hero.title.after}
      ledeSentence1={hero.lede.sentence1}
      ledeSentence2={hero.lede.sentence2}
      ledeAnchorText={hero.lede.anchor.text}
      ledeAnchorHref={hero.lede.anchor.href}
      ctaLabel={hero.cta.label}
      ctaHref={hero.cta.href}
      bookingLabel={hero.bookingLabel}
    />

    {/* Beat 2 — Statement (conviction beat, --bg, no band).
        --space-16 (64px) above/below via .home-statement-gap.
        Scroll-reveal: data-reveal on the gap wrapper — whole unit fades+rises. */}
    <div class="home-statement-gap" data-reveal>
      <HomeStatement text={statement.text} />
    </div>

    {/* Beat 3 — Artifact exhibit (inset OBJECT on --surface — NOT a band).
        --space-16 cross-beat gap above and below via .home-artifact-gap.
        Renders ONLY if artifact block is present and complete (all-or-nothing).
        If absent, this beat does not render; What-we-do absorbs mid-page weight.
        Scroll-reveal: whole CodeBlock reveals as ONE unit, no line-by-line. */}
    {artifact && (
      <div class="home-artifact-gap" data-reveal>
        <HomeArtifact
          language={artifact.language}
          code={artifact.code}
          caption={artifact.caption}
          label={artifact.label}
        />
      </div>
    )}

    {/* Beat 4 — What we do (first <h2>). Asymmetric lead+two, --bg, no band.
        Scroll-reveal: stagger=true — each card reveals individually (60ms step).
        Composition §A3-4 "whole-unit" default overridden by Arian 2026-06-21. */}
    <HomeDisciplines
      heading={disciplines.heading}
      items={disciplines.items}
      lead={disciplines.lead}
      stagger
    />

    {/* Beat 5 — Why us (second <h2>). Recessed band #1 of 2.
        .home-whyus-band: full-bleed --surface-section wrapper.
        Scroll-reveal: data-reveal on the band wrapper — whole exhibit reveals together. */}
    <div class="home-whyus-band" data-reveal>
      <HomeComparison
        heading={comparison.heading}
        metric={comparison.metric}
        rows={comparison.rows}
        stance={comparison.stance}
        link={comparison.link}
      />
    </div>

    {/* --space-12 (48px) air between band #1 and band #2 — merge-guard.
        The band wrapper closes above; --bg canvas shows here; CTASection opens below.
        This gap is the single most important separator between the two bands. */}
    <div class="home-convert-gap"></div>

    {/* Beat 6 — Closing CTASection (third <h2>). Recessed band #2 of 2.
        "The demo was never the hard part." — display-adjacent serif italic close.
        CTASection surface="recessed" (inside .home-convert-close-wrap for serif CSS).
        data-reveal: conversion terminus still gets a quiet entrance. */}
    <div data-reveal>
      <HomeClosingCta
        heading={closingCta.heading}
        body={closingCta.body}
        ctaLabel={closingCta.ctaLabel}
        ctaHref={closingCta.ctaHref}
        bookingLabel={closingCta.bookingLabel}
      />
    </div>
  </div>
</BaseLayout>
{/* All page-level CSS lives in src/styles/site.css (not a scoped <style> here):
    Astro inlines small scoped styles into the page <style>, which the
    production CSP (style-src 'self') blocks — it failed csp-compat (CR-4). */}
