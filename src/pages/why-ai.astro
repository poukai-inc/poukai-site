---
/**
 * /why-ai — Thesis page: the AI deployment gap and five failure modes.
 *
 * All copy sourced from src/content/why-ai.json (R-076 HARD) and validated at
 * build time via src/content/_schemas/why-ai.ts (R-074 HARD).
 * Failure-mode cards continue to source from src/content/failure-modes.json
 * via the existing content collection (unchanged).
 *
 * Decisions honoured:
 *   D-01 — footnote-style superscript citations → References block
 *   D-02 — sticky right-rail TOC on desktop ≥ 1024px, CSS-only
 *   D-03 — "Last reviewed" footer
 *   D-04 — discovery questions as inline italic <blockquote>
 *   D-05 — opening + quartile stats render via DS <Stat> molecule
 *   OMC-V1/V4/V5/V6/V7 — prospect-audience rewrite, em-dash titles, "AI systems"
 *     canonical noun, canonical H1 phrasing (ratified 2026-05-19).
 *
 * Depth pass (raise-the-ceiling — 2026-06-16, all 5 deltas):
 *   §4.1 — Hero entrance="stagger"
 *   §4.2 — StatsSection fill dividers (opening stats band — the page's ONE fill band)
 *   §4.3 — FailureModeList wrapping five FailureMode molecules
 *   §4.4 — Statement pivot between failure modes and leaders
 *   §4.5 — PrincipleList vs-alternatives section in the whereWorks block
 *   §4.5a — discoveryIntro repositioned immediately before the blockquote (A6)
 *   Composition: meta/compositions/pages/why-ai.md (In review 2026-06-16)
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  Hero,
  FailureMode,
  FailureModeList,
  Stat,
  StatsSection,
  Statement,
  PrincipleList,
  Principle,
} from "@poukai-inc/ui";
import { BOOKING_URL } from "../lib/booking";
import whyAiRaw from "../content/why-ai.json";
import { whyAiSchema } from "../content/_schemas/why-ai";

// file() loader returns one CollectionEntry per array item; .data holds the item.
const failureModeEntries = await getCollection("failure-modes");
const sortedModes = failureModeEntries
  .map((e) => e.data)
  .sort((a, b) => a.index - b.index);

const whyAi = whyAiSchema.parse(whyAiRaw);
const {
  meta,
  hero,
  openingArgument,
  pivot,
  statement,
  failureModesIntro,
  leaders,
  whereWorks,
  vsAlternatives,
  endCta,
  references,
  referencesNote,
  lastReviewed,
  jsonLd,
} = whyAi;

// Footnote marker derived from stat.citation (any digit count) rather than the
// map position, so adding a 5th stat can't silently render `undefined`.
const SUPERSCRIPT_DIGITS = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"];
const toSuperscript = (n: number) =>
  String(n)
    .split("")
    .map((d) => SUPERSCRIPT_DIGITS[Number(d)])
    .join("");
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  jsonLd={jsonLd}
  ogType="article"
  currentRoute="/why-ai"
>
  <div class="site-page">
    <!-- Section 2: Hero — entrance="stagger" per §4.1. DS-default size="display" retained. -->
    <Hero title={hero.title} lede={hero.lede} entrance="stagger" />

    <div class="why-ai-layout">
      <div class="why-ai-main">

        <!-- Section 3: Opening argument with inline cited stats -->
        <section aria-label="The deployment gap">
          <p>
            {openingArgument.intro}
            {openingArgument.stats.map((stat, i) => (
              <>
                <strong>{stat.highlight}</strong><sup class="footnote-ref"><a href={`#ref-${stat.citation}`} id={`cite-${stat.citation}`}>{toSuperscript(stat.citation)}</a></sup>
                {openingArgument.connectors[i]}
              </>
            ))}
          </p>

          <p>{pivot}</p>
        </section>

        <!-- Section 4: Headline stats band — StatsSection fill dividers per §4.2.
             The page's ONE --surface-section fill band (W-A floor).
             heading omitted: adjacent prose names the moment; omitting avoids a stray
             <h2> ahead of the first real section heading. -->
        <StatsSection fill dividers>
          {openingArgument.statsRow.map((stat) => (
            <Stat value={stat.value} caption={stat.caption} source={stat.source} size="lg" />
          ))}
        </StatsSection>

        <!-- Section 5: FailureModeList per §4.3.
             heading + lede move INTO the organism; no standalone <h2> remains.
             Per-mode <section id aria-label> wrappers retained for deep-link anchors
             (#data-readiness … #change-management) and sticky TOC (D-02).
             Per-mode stats stay as the current .stats-row (NOT a nested StatsSection —
             would paint extra bands; breaks the one-band budget). -->
        <FailureModeList
          heading={failureModesIntro.heading}
          lede={failureModesIntro.paragraph}
        >
          {sortedModes.map((mode) => (
            <section id={mode.anchor} aria-label={mode.title}>
              <FailureMode index={mode.index} title={mode.title}>
                {mode.stats.length > 0 && (
                  <div class="stats-row" role="list" aria-label={`Statistics for failure mode ${mode.index}`}>
                    {mode.stats.map((stat) => (
                      <div role="listitem">
                        <Stat value={stat.value} caption={stat.caption} source={stat.source} size="lg" />
                      </div>
                    ))}
                  </div>
                )}
                <p>{mode.body}</p>
              </FailureMode>
            </section>
          ))}
        </FailureModeList>

        <!-- Section 6: Statement thesis pivot per §4.4.
             On --bg (no band). hairline={false} default — editorial, not a section divider.
             Sits between FailureModeList and the "What the leaders do differently" heading. -->
        <Statement statement={statement} />

        <!-- Section 7: What the leaders do differently.
             Quartile stats as StatsSection WITHOUT fill — stays on --bg (no second band, W-A). -->
        <h2>{leaders.heading}</h2>
        <p>{leaders.intro}</p>
        <ul class="leaders-list">
          {leaders.items.map((item) => (
            <li><strong>{item.title}</strong> — {item.body}</li>
          ))}
        </ul>

        <p>{leaders.outro}</p>

        <StatsSection dividers>
          {leaders.stats.map((stat) => (
            <Stat value={stat.value} caption={stat.caption} size="lg" />
          ))}
        </StatsSection>

        <!-- Section 8: Where pouk.ai works — heading + body (unchanged) -->
        <h2>{whereWorks.heading}</h2>
        <p>{whereWorks.body}</p>

        <!-- Section 9: vs-alternatives — PrincipleList per §4.5/§4.5a.
             On --bg, no band, no figures, no Stat atoms (categorical-only, D-01 untouched).
             Inserted after whereWorks.body and before the repositioned discoveryIntro (A6).
             F-101 payoff: heading "When to hire pouk.ai — and when not to" answers the
             homepage link "See when to hire us, and when not to →". -->
        <PrincipleList
          heading={vsAlternatives.heading}
          lede={vsAlternatives.leadIn}
        >
          <Principle numeral="i" title={vsAlternatives.alternatives[0].name}>
            <p>{vsAlternatives.alternatives[0].rightWhen}</p>
            <p>{vsAlternatives.alternatives[0].poukaiWhen}</p>
          </Principle>
          <Principle numeral="ii" title={vsAlternatives.alternatives[1].name}>
            <p>{vsAlternatives.alternatives[1].rightWhen}</p>
            <p>{vsAlternatives.alternatives[1].poukaiWhen}</p>
          </Principle>
          <Principle numeral="iii" title={vsAlternatives.alternatives[2].name}>
            <p>{vsAlternatives.alternatives[2].rightWhen}</p>
            <p>{vsAlternatives.alternatives[2].poukaiWhen}</p>
          </Principle>
        </PrincipleList>

        <p>{vsAlternatives.closing}</p>

        <!-- Section 10: discoveryIntro repositioned immediately before the blockquote (A6).
             Composition §4.5a resolution: moves past vsAlternatives so "Four questions…"
             reads as the direct lead-in to the discovery <blockquote>, not to vs-alternatives. -->
        <p>{whereWorks.discoveryIntro}</p>

        <!-- Section 11: Discovery questions — inline italic blockquote per D-04 -->
        <blockquote class="discovery-questions" cite="https://pouk.ai/why-ai">
          <ol>
            {whereWorks.questions.map((q) => (
              <li><em>{q}</em></li>
            ))}
          </ol>
        </blockquote>

        <!-- Section 12: whereWorks.closing — non-conviction handoff line.
             The promoted Statement sentence has moved to the pivot; this is the new handoff. -->
        <p>{whereWorks.closing}</p>

        <!-- Section 13: End CTA — dual contact mechanism (FS-CF-1, booking-affordance §2 Context B).
             Conversion pair: mailto: primary + booking secondary (muted link).
             Navigational hand-off: Roles → stays as a separate read-on line below.
             Three affordances read as: conversion pair | navigation hand-off (§6 Flag 1 resolved). -->
        <div class="end-cta">
          <p>
            {endCta.primary.lead}{" "}
            <a href={endCta.primary.href}>{endCta.primary.email}</a>
            {" — "}
            <a href={BOOKING_URL} class="booking-link">{endCta.booking.label}</a>
          </p>
          <p>
            {endCta.secondary.lead}{" "}
            <a href={endCta.secondary.anchor.href}>{endCta.secondary.anchor.text}</a>
          </p>
        </div>

        <!-- Section 14: References — per D-01, footnote-style round-trip.
             vs-alternatives adds no cited stats → no new References entries (D-01 stays complete,
             references.length(4) untouched). -->
        <section class="references" aria-label="References">
          <h2>References</h2>
          <ol>
            {references.map((ref) => (
              <li id={`ref-${ref.index}`}>
                <a href={ref.url} rel="noopener noreferrer">{ref.title}</a> — {ref.source}
                <a href={`#cite-${ref.index}`} aria-label={`Back to citation ${ref.index}`}>↩</a>
              </li>
            ))}
          </ol>
          <p><em>{referencesNote}</em></p>
        </section>

        <!-- Last reviewed footer per D-03 -->
        <p class="last-reviewed">
          Last reviewed: {lastReviewed.date}. {lastReviewed.lead}{" "}
          <a href={lastReviewed.href}>{lastReviewed.email}</a> {lastReviewed.suffix}
        </p>

      </div>

      <!-- Sticky right-rail TOC — desktop only, CSS-only, no JS per D-02.
           Scoped to failure-mode anchors only (composition §8 — no vs-alternatives entry). -->
      <nav class="why-ai-toc" aria-label="Page sections">
        <p class="why-ai-toc-label">Failure modes</p>
        <ol>
          {sortedModes.map((mode) => (
            <li><a href={`#${mode.anchor}`}>{mode.index}. {mode.title}</a></li>
          ))}
        </ol>
      </nav>
    </div>
  </div>
</BaseLayout>
